# ==============================================================================
# MediCore Nexus - Environment Configuration Template
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME="MediCore Nexus"
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
SECRET_KEY=medicore_nexus_super_secret_jwt_signing_key_for_development_only_change_in_prod_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./medicore_nexus.db

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0

# AI / ML Service Configuration
AI_CONFIDENCE_THRESHOLD=0.85
ENABLE_AI_CLINICAL_SUPPORT=true
ENABLE_PREDICTIVE_INVENTORY=true

# Storage & Documents
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Telemedicine & Communications
TELEMEDICINE_PROVIDER=simulated_webrtc
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test_user
SMTP_PASSWORD=test_password
SMS_PROVIDER=mock_sms_gateway
